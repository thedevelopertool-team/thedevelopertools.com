---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonicalUrl,
  ogTitle,
  ogDescription,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://thedevelopertools.com';
const canonical = canonicalUrl ? canonicalUrl : `${siteUrl}${Astro.url.pathname}`;
const ogImg = `${siteUrl}/og-image.png`;
const resolvedOgTitle = ogTitle || title;
const resolvedOgDesc = ogDescription || description;
const jsonLdString = jsonLd ? JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:site_name" content="The Developer Tools" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content={ogImg} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts: Geist Sans + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/src/styles/global.css" />

    <!-- JSON-LD Structured Data -->
    {jsonLdString && (
      <script is:inline type="application/ld+json" set:html={jsonLdString} />
    )}

    <!-- Dark mode init: runs before paint to avoid flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || (!stored && true)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot name="nav" />
    <slot />
    <slot name="footer" />
  </body>
</html>
