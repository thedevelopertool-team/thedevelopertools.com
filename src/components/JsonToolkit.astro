---
// JsonToolkit.astro — HTML template only.
// All CSS is in src/styles/json-toolkit.css (loaded via <style is:global>).
// All JS/TS is in src/scripts/json-toolkit/index.ts (loaded via <script>).

interface Props {
  initialTab?: string;
}

const { initialTab = "formatter" } = Astro.props;
---

<div class="jt-root" id="json-toolkit" data-initial-tab={initialTab}>

  <!-- ═══════════════════════════════════════════════════════
       STANDARD 2-COLUMN WORKSPACE (all tools except Compare)
  ═══════════════════════════════════════════════════════ -->
  <div class="jt-standard-workspace" id="jt-standard-workspace">

    <!-- LEFT COLUMN — MASTER INPUT -->
    <div class="jt-input-col" id="jt-input-col">
      <div class="jt-panel-header">
        <div class="jt-header-title">
          <span class="eyebrow">JSON INPUT</span>
        </div>
        <div class="jt-input-actions">
          <button id="btn-sample" class="btn btn-ghost-sm jt-btn" type="button" title="Load sample JSON">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Sample
          </button>
          <button id="btn-load-file" class="btn btn-ghost-sm jt-btn" type="button" title="Import JSON file">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Import
          </button>
          <button id="btn-clear" class="btn btn-ghost-sm jt-btn" type="button" title="Clear input">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
            Clear
          </button>
          <button id="btn-fullscreen-main" class="btn btn-ghost-sm jt-btn" type="button" title="Toggle fullscreen view" aria-label="Toggle fullscreen">
            <svg class="icon-expand" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
            <svg class="icon-compress" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          </button>
        </div>
      </div>

      <div class="jt-drop-zone" id="jt-drop-zone">
        <textarea
          id="jt-input"
          class="jt-textarea"
          placeholder='Paste JSON here, drop a .json file, or click "Sample"…'
          spellcheck="false"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          aria-label="JSON input"
          aria-describedby="jt-status"
        ></textarea>
        <div class="jt-drop-overlay" id="jt-drop-overlay" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>Drop .json file to load</span>
        </div>
      </div>

      <input type="file" id="jt-file-input" accept=".json,application/json,text/plain" aria-hidden="true" style="display:none" />

      <div class="jt-status-row" id="jt-status" aria-live="polite" aria-atomic="true">
        <span class="jt-status-idle" id="jt-status-idle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Ready — paste or import JSON
        </span>
        <span class="jt-status-valid" id="jt-status-valid" hidden>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span id="jt-valid-detail">Valid JSON</span>
        </span>
        <span class="jt-status-error" id="jt-status-error" hidden>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <span id="jt-error-summary">Invalid JSON</span>
        </span>
      </div>
    </div><!-- /jt-input-col -->

    <!-- CENTER DIVIDER -->
    <div class="jt-divider" aria-hidden="true"></div>

    <!-- RIGHT COLUMN — TOOL NAVIGATION + OUTPUT -->
    <div class="jt-output-col">

      <!-- Navigation Header Bar -->
      <div class="jt-tabs-header" role="navigation" aria-label="JSON operations">
        <div class="jt-tabs-group" role="tablist">
          <button class="jt-tab active" role="tab" aria-selected="true"  data-tab="formatter"  aria-controls="jt-panel-formatter"  id="tab-formatter">Format</button>
          <button class="jt-tab"        role="tab" aria-selected="false" data-tab="viewer"     aria-controls="jt-panel-viewer"     id="tab-viewer">Tree View</button>
          <button class="jt-tab"        role="tab" aria-selected="false" data-tab="validator"  aria-controls="jt-panel-validator"  id="tab-validator">Validate</button>
          <button class="jt-tab"        role="tab" aria-selected="false" data-tab="minifier"   aria-controls="jt-panel-minifier"   id="tab-minifier">Minify</button>
          <button class="jt-tab"        role="tab" aria-selected="false" data-tab="compare"    aria-controls="jt-compare-workspace" id="tab-compare">Compare</button>

          <span class="jt-tab-sep" aria-hidden="true"></span>

          <!-- Convert Dropdown -->
          <div class="jt-dropdown" id="dd-convert">
            <button class="jt-tab jt-dropdown-trigger" id="btn-dd-convert" type="button" aria-expanded="false" aria-haspopup="menu" aria-label="Conversion tools">
              <span id="label-dd-convert">Convert</span>
              <svg class="jt-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="jt-dropdown-menu" id="menu-convert" role="menu" hidden>
              <button class="jt-dropdown-item" role="menuitem" data-tab="csv">
                <span class="jt-dd-title">JSON to CSV</span><span class="jt-dd-badge">.csv</span>
              </button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="yaml">
                <span class="jt-dd-title">JSON to YAML</span><span class="jt-dd-badge">.yaml</span>
              </button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="xml">
                <span class="jt-dd-title">JSON to XML</span><span class="jt-dd-badge">.xml</span>
              </button>
            </div>
          </div>

          <!-- Types & Code Dropdown -->
          <div class="jt-dropdown" id="dd-types">
            <button class="jt-tab jt-dropdown-trigger" id="btn-dd-types" type="button" aria-expanded="false" aria-haspopup="menu" aria-label="Code and Schema generation tools">
              <span id="label-dd-types">Types &amp; Code</span>
              <svg class="jt-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="jt-dropdown-menu jt-dropdown-menu-wide" id="menu-types" role="menu" hidden>
              <div class="jt-dd-section-title">Type Systems &amp; Schemas</div>
              <button class="jt-dropdown-item" role="menuitem" data-tab="typescript"><span class="jt-dd-title">TypeScript Interfaces</span><span class="jt-dd-badge">.ts</span></button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="zod"><span class="jt-dd-title">Zod Schema</span><span class="jt-dd-badge">.ts</span></button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="schema"><span class="jt-dd-title">JSON Schema (draft-07)</span><span class="jt-dd-badge">.json</span></button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="openapi"><span class="jt-dd-title">OpenAPI 3.0 Schema</span><span class="jt-dd-badge">.yaml</span></button>
              <div class="jt-dd-section-title">Backend Models &amp; Structs</div>
              <button class="jt-dropdown-item" role="menuitem" data-tab="go"><span class="jt-dd-title">Go Structs</span><span class="jt-dd-badge">.go</span></button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="pydantic"><span class="jt-dd-title">Python Pydantic v2</span><span class="jt-dd-badge">.py</span></button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="java"><span class="jt-dd-title">Java POJO (Jackson)</span><span class="jt-dd-badge">.java</span></button>
              <button class="jt-dropdown-item" role="menuitem" data-tab="kotlin"><span class="jt-dd-title">Kotlin Data Classes</span><span class="jt-dd-badge">.kt</span></button>
            </div>
          </div>
        </div>

        <!-- Compact Search Icon — never competes with tabs -->
        <button id="btn-search-toggle" class="jt-search-toggle-btn" type="button" title="Search keys &amp; values (Ctrl+F)" aria-label="Open search" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div><!-- /jt-tabs-header -->

      <!-- Floating Search Bar — shown below tabs when search icon is clicked -->
      <div class="jt-search-bar" id="jt-search-bar" role="search" hidden>
        <svg class="jt-search-bar-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          id="jt-search-input"
          type="text"
          class="jt-search-input"
          placeholder="Search keys &amp; values…"
          aria-label="Search JSON keys and values"
          autocomplete="off"
          spellcheck="false"
        />
        <span id="jt-search-count" class="jt-search-counter" hidden>0 / 0</span>
        <div class="jt-search-nav-btns" id="jt-search-nav-btns" hidden>
          <button id="btn-search-prev" class="jt-search-nav-btn" type="button" title="Previous (Shift+Enter)" aria-label="Previous match">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
          </button>
          <button id="btn-search-next" class="jt-search-nav-btn" type="button" title="Next (Enter)" aria-label="Next match">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
        <button id="btn-search-clear" class="jt-search-clear-btn" type="button" title="Clear search" aria-label="Clear search" hidden>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <button id="btn-search-close" class="jt-search-close-btn" type="button" title="Close search (Esc)" aria-label="Close search">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Output Panels -->
      <div class="jt-panels">

        <!-- 1. FORMATTER -->
        <div class="jt-panel" id="jt-panel-formatter" role="tabpanel" aria-labelledby="tab-formatter">
          <div class="jt-panel-toolbar">
            <span class="eyebrow">INDENT</span>
            <div class="jt-indent-group" role="group" aria-label="Indentation spacing">
              <button class="jt-indent-btn active" data-indent="2"   type="button">2</button>
              <button class="jt-indent-btn"        data-indent="4"   type="button">4</button>
              <button class="jt-indent-btn"        data-indent="tab" type="button">Tab</button>
            </div>
            <div class="jt-panel-toolbar-right">
              <button class="btn btn-ghost-sm jt-btn" id="btn-format-input" type="button" title="Format the input JSON">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                <span>Format Input</span>
              </button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-copy-formatter" type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-dl-formatter" type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Download</span>
              </button>
            </div>
          </div>
          <textarea id="out-formatter" class="jt-output-textarea" readonly aria-label="Formatted JSON output" spellcheck="false"></textarea>
        </div>

        <!-- 2. HIERARCHICAL TREE VIEWER -->
        <div class="jt-panel" id="jt-panel-viewer" role="tabpanel" aria-labelledby="tab-viewer" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">HIERARCHICAL TREE</span>
            <div class="jt-panel-toolbar-right">
              <button class="btn btn-ghost-sm jt-btn" id="btn-expand-all" type="button" title="Expand every nested level">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                Expand All
              </button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-collapse-all" type="button" title="Collapse to top-level keys">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                Collapse All
              </button>
            </div>
          </div>
          <div id="out-viewer" class="jt-tree-container" aria-label="Interactive JSON tree viewer">
            <div class="jt-panel-empty">Paste JSON on the left to explore the interactive tree.</div>
          </div>
        </div>

        <!-- 3. VALIDATOR -->
        <div class="jt-panel" id="jt-panel-validator" role="tabpanel" aria-labelledby="tab-validator" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">SYNTAX VALIDATION</span>
          </div>
          <div id="out-validator" class="jt-validator-output">
            <div class="jt-panel-empty">Paste JSON on the left to validate syntax.</div>
          </div>
        </div>

        <!-- 4. MINIFIER -->
        <div class="jt-panel" id="jt-panel-minifier" role="tabpanel" aria-labelledby="tab-minifier" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">MINIFIED JSON</span>
            <div class="jt-panel-toolbar-right">
              <span class="jt-stat" id="stat-minifier"></span>
              <button class="btn btn-ghost-sm jt-btn" id="btn-copy-minifier" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span></button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-dl-minifier"  type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download</span></button>
            </div>
          </div>
          <textarea id="out-minifier" class="jt-output-textarea" readonly aria-label="Minified JSON output" spellcheck="false"></textarea>
        </div>

        <!-- 5. CSV -->
        <div class="jt-panel" id="jt-panel-csv" role="tabpanel" aria-labelledby="tab-csv" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">CSV OUTPUT</span>
            <div class="jt-panel-toolbar-right">
              <button class="btn btn-ghost-sm jt-btn" id="btn-copy-csv" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span></button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-dl-csv"   type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download .csv</span></button>
            </div>
          </div>
          <textarea id="out-csv" class="jt-output-textarea" readonly aria-label="CSV output" spellcheck="false"></textarea>
        </div>

        <!-- 6. YAML -->
        <div class="jt-panel" id="jt-panel-yaml" role="tabpanel" aria-labelledby="tab-yaml" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">YAML OUTPUT</span>
            <div class="jt-panel-toolbar-right">
              <button class="btn btn-ghost-sm jt-btn" id="btn-copy-yaml" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span></button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-dl-yaml"   type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download .yaml</span></button>
            </div>
          </div>
          <textarea id="out-yaml" class="jt-output-textarea" readonly aria-label="YAML output" spellcheck="false"></textarea>
        </div>

        <!-- 7. XML -->
        <div class="jt-panel" id="jt-panel-xml" role="tabpanel" aria-labelledby="tab-xml" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">XML OUTPUT</span>
            <div class="jt-panel-toolbar-right">
              <button class="btn btn-ghost-sm jt-btn" id="btn-copy-xml" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span></button>
              <button class="btn btn-ghost-sm jt-btn" id="btn-dl-xml"   type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download .xml</span></button>
            </div>
          </div>
          <textarea id="out-xml" class="jt-output-textarea" readonly aria-label="XML output" spellcheck="false"></textarea>
        </div>

        <!-- 8. TYPESCRIPT -->
        <div class="jt-panel" id="jt-panel-typescript" role="tabpanel" aria-labelledby="tab-typescript" hidden>
          <div class="jt-panel-toolbar">
            <span class="eyebrow">TYPESCRIPT TYPES</span>
            <div class="jt-panel-toolbar-right">
              <button class="btn btn-ghost-sm jt-btn" id="btn-copy-typescript" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copy</span></button>
