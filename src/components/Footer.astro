---
// Footer.astro
---

<footer class="site-footer" role="contentinfo">
  <div class="container-site footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="The Developer Tools">
          <span class="footer-logo-icon-wrap" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 7L2 10L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14 7L18 10L14 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M11.5 5L8.5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </span>
          <span>The Developer Tools</span>
        </a>
        <p class="footer-tagline">Free, private, browser-based developer utilities.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-nav-group">
          <span class="footer-nav-heading eyebrow">Tools</span>
          <ul class="footer-nav-list" role="list">
            <li><a href="/" class="footer-nav-link">All Tools</a></li>
            <li><a href="/password-generator" class="footer-nav-link">Password Generator</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} The Developer Tools. All rights reserved.
      </p>
      <p class="footer-privacy">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:middle;margin-right:4px">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        100% client-side — no data leaves your browser
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--c-canvas);
    border-top: 1px solid var(--c-hairline);
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .footer-inner {
    padding-top: 48px;
    padding-bottom: 32px;
  }

  .footer-top {
    display: flex;
    gap: 48px;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 260px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--c-ink);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: opacity 120ms ease;
  }

  .footer-logo-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background-color: var(--c-ink);
    color: var(--c-canvas);
    flex-shrink: 0;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .footer-logo:hover { opacity: 0.7; }

  .footer-tagline {
    margin: 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--c-mute);
  }

  .footer-nav {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer-nav-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-nav-heading {
    display: block;
    margin-bottom: 4px;
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-nav-link {
    font-size: 14px;
    color: var(--c-body);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .footer-nav-link:hover {
    color: var(--c-ink);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--c-hairline);
  }

  .footer-copy {
    margin: 0;
    font-size: 13px;
    color: var(--c-mute);
  }

  .footer-privacy {
    margin: 0;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--c-mute);
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>
