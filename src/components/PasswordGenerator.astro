  @media (max-width: 640px) {
    /* Password field action buttons: icon-only on mobile */
    .action-label {
      display: none;
    }

    .btn-action {
      padding: 6px;
      width: 34px;
      height: 34px;
    }

    /* Character sets: single column on mobile */
    .pg-checkbox-grid-2col {
      grid-template-columns: 1fr;
    }

    /* Strength row: stacks on mobile */
    .pg-strength-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    /* QR panel: stack canvas + download button vertically */
    .pg-qr-compact-body {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    /* On mobile: centre the canvas in its own row */
    .pg-qr-canvas-box {
      align-self: center;
    }

    /* Download button goes full-width on mobile */
    .pg-qr-actions {
      width: 100%;
      align-self: stretch;
    }

    .pg-qr-download-btn {
      width: 100%;
      justify-content: center;
      padding: 10px 16px;
      font-size: 14px;
      border-radius: 8px;
    }

    /* Hint text fills width on mobile */
    .pg-qr-hint {
      max-width: 100%;
      text-align: center;
    }
