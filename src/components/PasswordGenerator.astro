---
// PasswordGenerator.astro
// All client-side logic in <script>. Uses window.crypto.getRandomValues() exclusively.
---

<div class="pg-wrap" id="password-generator">
  
  <!-- Single Unified Tool Card (Reference Design Architecture) -->
  <div class="pg-card" role="region" aria-label="Password generator tool">

    <!-- === 1. COHESIVE PASSWORD OUTPUT FIELD === -->
    <div class="pg-output-group">
      <!-- Password Box with attached QR & Copy buttons -->
      <div class="pg-password-box">
        <div
          id="pw-display"
          class="pg-password-display"
          role="textbox"
          aria-readonly="true"
          aria-label="Generated password"
          aria-multiline="false"
          tabindex="0"
        ></div>

        <!-- Attached Action Buttons -->
        <div class="pg-password-actions">
          <!-- QR Toggle Button -->
          <button
            id="btn-qr-toggle"
            class="btn btn-action"
            type="button"
            aria-label="Toggle QR code for this password"
            title="Show QR Code"
            aria-expanded="false"
          >
            <svg class="action-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7"/>
              <rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/>
              <rect x="3" y="14" width="7" height="7"/>
            </svg>
            <span id="qr-btn-label" class="action-label">QR</span>
          </button>

          <!-- Copy Button -->
          <button
            id="btn-copy"
            class="btn btn-action"
            type="button"
            aria-label="Copy password to clipboard"
            title="Copy password"
          >
            <svg id="icon-copy" class="action-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <svg id="icon-check" class="action-icon action-icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span id="copy-label" class="action-label">Copy</span>
          </button>
        </div>
      </div>

      <!-- Compact Strength Row directly below password field -->
      <div class="pg-strength-row" role="region" aria-labelledby="strength-label">
        <span id="strength-label" class="eyebrow pg-strength-title">STRENGTH</span>
        <div class="pg-strength-right">
          <span id="strength-text" class="pg-strength-text" aria-live="polite">—</span>
          <div class="pg-strength-bar" role="progressbar" aria-labelledby="strength-label" aria-valuenow="0" aria-valuemin="0" aria-valuemax="4" id="strength-bar">
            <div class="strength-segment" id="seg1"></div>
            <div class="strength-segment" id="seg2"></div>
            <div class="strength-segment" id="seg3"></div>
            <div class="strength-segment" id="seg4"></div>
          </div>
          <span id="strength-detail" class="pg-strength-detail" aria-live="polite"></span>
        </div>
      </div>

      <!-- Compact QR Preview (shown when QR button toggled) -->
      <div id="qr-container" class="pg-qr-compact-panel" hidden>
        <div class="pg-qr-compact-header">
          <span class="eyebrow">QR for this password</span>
        </div>
        <div class="pg-qr-compact-body">
          <!-- QR canvas, always visible -->
          <div class="pg-qr-canvas-box">
            <canvas id="qr-canvas" class="pg-qr-canvas" aria-label="QR code of the generated password"></canvas>
          </div>
          <!-- Download action: beside canvas on desktop, below on mobile -->
          <div class="pg-qr-actions">
            <button id="btn-download-qr" class="btn btn-ghost-sm pg-qr-download-btn" type="button" aria-label="Download QR code as JPEG">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download QR
            </button>
            <p class="pg-qr-hint">Scan to transfer your password to another device</p>
          </div>
        </div>
      </div>

      <!-- Validation Warning -->
      <div id="pg-warning" class="pg-warning" hidden role="alert" aria-live="assertive">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span id="pg-warning-text">Please select at least one character set.</span>
      </div>
    </div>

    <!-- === 2. COMPACT GENERATION CONTROLS === -->
    <div class="pg-controls-group">
      
      <!-- Length Slider -->
      <div class="pg-field">
        <div class="pg-field-label-row">
          <label for="pw-length" class="pg-label">Length</label>
          <output id="pw-length-display" class="pg-value-badge" for="pw-length">16</output>
        </div>
        <input
          id="pw-length"
          type="range"
          min="6"
          max="64"
          value="16"
          step="1"
          class="pg-slider"
          aria-label="Password length"
          aria-valuemin="6"
          aria-valuemax="64"
          aria-valuenow="16"
        />
      </div>

      <!-- Character Sets (2-Column Layout on Desktop) -->
      <div class="pg-checkbox-grid-2col" role="group" aria-label="Character set options">
        <label class="pg-checkbox-label">
          <input type="checkbox" id="opt-uppercase" checked class="pg-checkbox" />
          <span class="pg-checkbox-box" aria-hidden="true"></span>
          Uppercase (A-Z)
        </label>
        <label class="pg-checkbox-label">
          <input type="checkbox" id="opt-lowercase" checked class="pg-checkbox" />
          <span class="pg-checkbox-box" aria-hidden="true"></span>
          Lowercase (a-z)
        </label>
        <label class="pg-checkbox-label">
          <input type="checkbox" id="opt-numbers" checked class="pg-checkbox" />
          <span class="pg-checkbox-box" aria-hidden="true"></span>
          Numbers (0-9)
        </label>
        <label class="pg-checkbox-label">
          <input type="checkbox" id="opt-symbols" checked class="pg-checkbox" />
          <span class="pg-checkbox-box" aria-hidden="true"></span>
          Symbols (!@#$)
        </label>
      </div>

      <!-- Advanced Options Accordion (Collapsed by Default) -->
      <div class="pg-advanced-section">
        <button
          id="advanced-toggle"
          class="pg-accordion-trigger"
          aria-expanded="false"
          aria-controls="advanced-content"
          type="button"
        >
          <span class="pg-label" style="font-weight: 500;">Advanced Options</span>
          <svg class="pg-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <div id="advanced-content" class="pg-accordion-content" hidden>
          <div class="pg-advanced-inner">

            <!-- Custom symbol pool -->
            <div class="pg-field">
              <label for="custom-symbols" class="pg-label">Custom Symbol Pool</label>
              <input
                type="text"
                id="custom-symbols"
                class="field-input"
                value="!@#$%^&*()-_=+[]{}|;:,.<>?"
                placeholder="e.g. !@#$%"
                aria-describedby="custom-symbols-hint"
              />
              <p id="custom-symbols-hint" class="pg-field-hint">
                Directly edit active symbols used when Symbols is enabled.
              </p>
            </div>

            <!-- Checkboxes for advanced options -->
            <div class="pg-checkboxes" role="group" aria-label="Advanced character options">
              <label class="pg-checkbox-label">
                <input type="checkbox" id="opt-start-letter" class="pg-checkbox" />
                <span class="pg-checkbox-box" aria-hidden="true"></span>
                Start with a letter
              </label>
              <label class="pg-checkbox-label">
                <input type="checkbox" id="opt-readable" class="pg-checkbox" />
                <span class="pg-checkbox-box" aria-hidden="true"></span>
                Readable / Pronounceable mode
              </label>
              <label class="pg-checkbox-label">
                <input type="checkbox" id="opt-unique" class="pg-checkbox" />
                <span class="pg-checkbox-box" aria-hidden="true"></span>
                Unique characters only
              </label>
              <label class="pg-checkbox-label">
                <input type="checkbox" id="opt-exclude-similar" class="pg-checkbox" />
                <span class="pg-checkbox-box" aria-hidden="true"></span>
                Exclude similar characters
                <span class="pg-option-note">(i, l, 1, I, o, 0, O)</span>
              </label>
            </div>

          </div>
        </div>
      </div>

      <!-- Single Full-Width Primary Generate Password Button -->
      <div class="pg-generate-btn-wrap">
        <button id="btn-generate" class="btn btn-primary btn-generate-main" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
          Generate Password
        </button>
      </div>

    </div>

  </div>

  <!-- FAQ Section (Centered Cards matching Reference Screenshot) -->
  <section class="pg-faq" id="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="heading-md" style="margin-bottom: 16px; font-size: 18px;">
      Frequently Asked Questions
    </h2>

    <div class="pg-faq-list" id="faq-list" role="list">

      <div class="accordion-item faq-card" role="listitem" id="faq-private">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-1-body" id="faq-1-trigger" type="button">
          <span>Is this online password generator 100% private and secure?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-1-body" role="region" aria-labelledby="faq-1-trigger" hidden>
          <div class="faq-body">
            <p>Yes. Our secure password generator runs 100% inside your web browser using JavaScript's <code>window.crypto</code> API. No password data is ever transmitted across the network, stored on a server, or tracked by analytics.</p>
          </div>
        </div>
      </div>

      <div class="accordion-item faq-card" role="listitem" id="faq-verify">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-2-body" id="faq-2-trigger" type="button">
          <span>How can I verify no data leaves my browser?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-2-body" role="region" aria-labelledby="faq-2-trigger" hidden>
          <div class="faq-body">
            <p>Open your browser Developer Tools (F12 or Cmd+Option+I on Mac), navigate to the <strong>Network</strong> tab, clear the log, and generate a new password. You will see zero outbound network requests fired—only local browser memory is used.</p>
          </div>
        </div>
      </div>

      <div class="accordion-item faq-card" role="listitem" id="faq-effective">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-3-body" id="faq-3-trigger" type="button">
          <span>What makes a strong random password generator effective?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-3-body" role="region" aria-labelledby="faq-3-trigger" hidden>
          <div class="faq-body">
            <p>A strong random password generator relies on high-entropy cryptographically secure pseudo-random number generators (CSPRNG) to build unpredictable strings, making them immune to dictionary attacks, rainbow table lookups, and brute-force cracking.</p>
          </div>
        </div>
      </div>

      <div class="accordion-item faq-card" role="listitem" id="faq-free">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-4-body" id="faq-4-trigger" type="button">
          <span>Is this strong password generator free to use for personal and commercial needs?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-4-body" role="region" aria-labelledby="faq-4-trigger" hidden>
          <div class="faq-body">
            <p>Yes, our strong password generator free tool is 100% free with no registration, software installation, or usage caps.</p>
          </div>
        </div>
      </div>

      <div class="accordion-item faq-card" role="listitem" id="faq-offline">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-5-body" id="faq-5-trigger" type="button">
          <span>Can I use this random password generator online without an internet connection?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-5-body" role="region" aria-labelledby="faq-5-trigger" hidden>
          <div class="faq-body">
            <p>Yes. Once the web page is loaded, the password generator online operates completely offline without making any network requests.</p>
          </div>
        </div>
      </div>

      <div class="accordion-item faq-card" role="listitem" id="faq-readable">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-6-body" id="faq-6-trigger" type="button">
          <span>What is Readable / Pronounceable Mode?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-6-body" role="region" aria-labelledby="faq-6-trigger" hidden>
          <div class="faq-body">
            <p>Readable mode generates passwords following alternating consonant-vowel combinations. This creates strings like <code>baporinetu</code> that are easier to pronounce and remember while maintaining high cryptographic strength.</p>
          </div>
        </div>
      </div>

      <div class="accordion-item faq-card" role="listitem" id="faq-qr">
        <button class="accordion-trigger faq-card-trigger" aria-expanded="false" aria-controls="faq-7-body" id="faq-7-trigger" type="button">
          <span>How does the QR Code transfer work safely?</span>
          <svg class="faq-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="accordion-content" id="faq-7-body" role="region" aria-labelledby="faq-7-trigger" hidden>
          <div class="faq-body">
            <p>The QR code is rendered directly on an HTML5 canvas element inside your browser memory using client-side JavaScript. You can scan it with your mobile device to transfer your new password without cloud syncing or clipboard sniffing.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

</div>

<style>
  .pg-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  /* Single Tool Card (Matching Reference Screenshot) */
  .pg-card {
    background-color: var(--c-canvas-elevated);
    border: 1px solid var(--c-hairline);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  /* === 1. PASSWORD OUTPUT FIELD === */
  .pg-output-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pg-password-box {
    display: flex;
    align-items: center;
    background-color: var(--c-hairline-soft);
    border: 1px solid var(--c-hairline);
    border-radius: 8px;
    padding: 6px 8px 6px 14px;
    gap: 10px;
    transition: border-color 150ms ease;
  }

  .pg-password-box:focus-within {
    border-color: var(--c-ink);
  }

  .pg-password-display {
    flex: 1;
    font-family: var(--font-mono);
    font-size: clamp(15px, 3vw, 18px);
    font-weight: 500;
    line-height: 24px;
    color: var(--c-ink);
    word-break: break-all;
    letter-spacing: 0.04em;
    min-height: 40px;
    display: flex;
    align-items: center;
    cursor: text;
    user-select: all;
    outline: none;
  }

  .pg-password-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 12px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid var(--c-hairline);
    background-color: var(--c-canvas-elevated);
    color: var(--c-ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .btn-action:hover {
    background-color: var(--c-hairline-soft);
    border-color: var(--c-mute);
  }

  .btn-action.copied {
    background-color: #22c55e;
    border-color: #22c55e;
    color: #ffffff;
  }

  .btn-action.active {
    background-color: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-canvas);
  }

  .action-icon-check {
    color: currentColor;
  }

  /* Compact Strength Row */
  .pg-strength-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 2px 0 2px;
  }

  .pg-strength-title {
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--c-mute);
  }

  .pg-strength-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pg-strength-text {
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .pg-strength-bar {
    display: flex;
    gap: 4px;
    width: 64px;
  }

  .strength-segment {
    height: 4px;
    border-radius: 9999px;
    flex: 1;
    background-color: var(--c-hairline);
    transition: background-color 200ms ease;
  }

  .pg-strength-detail {
    font-size: 11px;
    color: var(--c-mute);
    font-family: var(--font-mono);
  }

  /* Strength Colors */
  .strength-too-weak { color: var(--c-error); }
  .strength-weak { color: var(--c-warning); }
  .strength-medium { color: #f0b429; }
  .strength-strong { color: #22c55e; }

  .seg-too-weak { background-color: var(--c-error) !important; }
  .seg-weak { background-color: var(--c-warning) !important; }
  .seg-medium { background-color: #f0b429 !important; }
  .seg-strong { background-color: #22c55e !important; }

  /* ── Compact QR Panel ── */
  .pg-qr-compact-panel {
    border: 1px solid var(--c-hairline);
    border-radius: 8px;
    background-color: var(--c-canvas);
    padding: 14px;
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pg-qr-compact-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Side-by-side on desktop: canvas left, actions right */
  .pg-qr-compact-body {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .pg-qr-canvas-box {
    background-color: #ffffff;
    padding: 6px;
    border: 1px solid var(--c-hairline);
    border-radius: 6px;
    display: inline-flex;
    flex-shrink: 0;
  }

  .pg-qr-canvas {
    width: 128px;
    height: 128px;
    image-rendering: pixelated;
    display: block;
  }

  /* Actions column beside QR on desktop */
  .pg-qr-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
    align-self: center;
  }

  .pg-qr-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }

  .pg-qr-hint {
    margin: 0;
    font-size: 11px;
    line-height: 16px;
    color: var(--c-mute);
    max-width: 160px;
  }

  /* Warning */
  .pg-warning {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background-color: var(--c-warning-soft, #ffefcf);
    border: 1px solid var(--c-warning);
    border-radius: 6px;
    font-size: 13px;
    color: var(--c-warning-deep, #ab570a);
  }

  /* === 2. GENERATION CONTROLS === */
  .pg-controls-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid var(--c-hairline);
    padding-top: 16px;
  }

  .pg-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pg-field-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pg-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--c-ink);
  }

  .pg-value-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--c-ink);
    background-color: var(--c-hairline-soft);
    border: 1px solid var(--c-hairline);
    border-radius: 4px;
    padding: 1px 6px;
    min-width: 28px;
    text-align: center;
  }

  .pg-field-hint {
    margin: 0;
    font-size: 12px;
    color: var(--c-mute);
  }

  .pg-option-note {
    font-family: var(--font-mono);
    font-size: 11px;
