</style>

<script>
  function loadQRLib(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).QRCode) { resolve(); return; }
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('QR library load failed'));
      document.head.appendChild(script);
    });
  }

  const CHAR_SETS = {
    uppercase: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lowercase: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{}|;:,.<>?',
  };

  const SIMILAR = new Set(['i', 'l', '1', 'I', 'o', '0', 'O']);
  const CONSONANTS = 'bcdfghjklmnpqrstvwxyz';
  const VOWELS = 'aeiou';

  function cryptoRandInt(max: number): number {
    const array = new Uint32Array(1);
    const limit = Math.floor(0x100000000 / max) * max;
    let val: number;
    do {
      window.crypto.getRandomValues(array);
      val = array[0];
    } while (val >= limit);
    return val % max;
  }

  function shuffleArray<T>(arr: T[]): T[] {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = cryptoRandInt(i + 1);
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function generateReadable(length: number, startWithLetter: boolean): string {
    let result = '';
    for (let i = 0; i < length; i++) {
      const useVowel = i % 2 === 1;
      const pool = useVowel ? VOWELS : CONSONANTS;
      let char = pool[cryptoRandInt(pool.length)];
      if (i === 0 && startWithLetter) {
        char = char.toUpperCase();
      }
      result += char;
    }
    return result;
  }

  interface GenOptions {
    length: number;
    uppercase: boolean;
    lowercase: boolean;
    numbers: boolean;
    symbols: boolean;
    customSymbols: string;
    startWithLetter: boolean;
    readable: boolean;
    unique: boolean;
    excludeSimilar: boolean;
  }

  function generatePassword(opts: GenOptions): string | null {
    const { length, uppercase, lowercase, numbers, symbols, customSymbols,
            startWithLetter, readable, unique, excludeSimilar } = opts;

    if (readable) {
      return generateReadable(length, startWithLetter);
    }

    let pool = '';
    if (uppercase) pool += CHAR_SETS.uppercase;
    if (lowercase) pool += CHAR_SETS.lowercase;
    if (numbers) pool += CHAR_SETS.numbers;
    if (symbols) pool += customSymbols.trim() || CHAR_SETS.symbols;

    if (!pool) return null;

    if (excludeSimilar) {
      pool = pool.split('').filter(c => !SIMILAR.has(c)).join('');
    }

    if (!pool) return null;

    if (unique && pool.length < length) {
      return null;
    }

    let result: string[] = [];
    const usedChars = new Set<string>();

    const guarantors: string[] = [];
    if (uppercase) {
      let pool2 = CHAR_SETS.uppercase;
      if (excludeSimilar) pool2 = pool2.split('').filter(c => !SIMILAR.has(c)).join('');
      if (pool2) guarantors.push(pool2[cryptoRandInt(pool2.length)]);
    }
    if (lowercase) {
      let pool2 = CHAR_SETS.lowercase;
      if (excludeSimilar) pool2 = pool2.split('').filter(c => !SIMILAR.has(c)).join('');
      if (pool2) guarantors.push(pool2[cryptoRandInt(pool2.length)]);
    }
    if (numbers) {
      let pool2 = CHAR_SETS.numbers;
      if (excludeSimilar) pool2 = pool2.split('').filter(c => !SIMILAR.has(c)).join('');
      if (pool2) guarantors.push(pool2[cryptoRandInt(pool2.length)]);
    }
    if (symbols) {
      let pool2 = customSymbols.trim() || CHAR_SETS.symbols;
      if (excludeSimilar) pool2 = pool2.split('').filter(c => !SIMILAR.has(c)).join('');
      if (pool2) guarantors.push(pool2[cryptoRandInt(pool2.length)]);
    }

    for (let i = guarantors.length; i < length; i++) {
      let char: string;
      let attempts = 0;
      do {
        char = pool[cryptoRandInt(pool.length)];
        attempts++;
      } while (unique && usedChars.has(char) && attempts < 10000);
      if (unique && usedChars.has(char)) break;
      result.push(char);
      if (unique) usedChars.add(char);
    }

    result.push(...guarantors.filter(c => !unique || !usedChars.has(c)));
    shuffleArray(result);
    result = result.slice(0, length);

    if (startWithLetter && result.length > 0) {
      let letterPool = '';
      if (uppercase) letterPool += CHAR_SETS.uppercase;
      if (lowercase) letterPool += CHAR_SETS.lowercase;
      if (!letterPool) letterPool = CHAR_SETS.uppercase + CHAR_SETS.lowercase;
      if (excludeSimilar) {
        letterPool = letterPool.split('').filter(c => !SIMILAR.has(c)).join('');
      }
      if (letterPool) {
        const firstLetter = letterPool[cryptoRandInt(letterPool.length)];
        result[0] = firstLetter;
      }
    }

    return result.join('');
  }

  function calcEntropy(password: string, opts: GenOptions): number {
    let poolSize = 0;
    if (opts.readable) {
      poolSize = CONSONANTS.length + VOWELS.length;
    } else {
      if (opts.uppercase) poolSize += 26;
      if (opts.lowercase) poolSize += 26;
      if (opts.numbers) poolSize += 10;
      if (opts.symbols) {
        const syms = opts.customSymbols.trim() || CHAR_SETS.symbols;
        poolSize += syms.length;
      }
      if (opts.excludeSimilar) poolSize = Math.max(poolSize - 7, 1);
    }
    if (poolSize < 2) return 0;
    return password.length * Math.log2(poolSize);
  }

  type StrengthLevel = 'too-weak' | 'weak' | 'medium' | 'strong';

  function getStrengthLevel(entropy: number): StrengthLevel {
    if (entropy < 28) return 'too-weak';
    if (entropy < 40) return 'weak';
    if (entropy < 60) return 'medium';
    return 'strong';
  }

  const STRENGTH_LABELS: Record<StrengthLevel, string> = {
    'too-weak': 'Too Weak',
    'weak': 'Weak',
    'medium': 'Medium',
    'strong': 'Strong',
  };

  const STRENGTH_SEGMENTS: Record<StrengthLevel, number> = {
    'too-weak': 1,
    'weak': 2,
    'medium': 3,
    'strong': 4,
  };

  // DOM References
  const lenSlider = document.getElementById('pw-length') as HTMLInputElement;
  const lenDisplay = document.getElementById('pw-length-display') as HTMLOutputElement;
  const cbUppercase = document.getElementById('opt-uppercase') as HTMLInputElement;
  const cbLowercase = document.getElementById('opt-lowercase') as HTMLInputElement;
  const cbNumbers = document.getElementById('opt-numbers') as HTMLInputElement;
  const cbSymbols = document.getElementById('opt-symbols') as HTMLInputElement;
  const inputCustomSymbols = document.getElementById('custom-symbols') as HTMLInputElement;
  const cbStartLetter = document.getElementById('opt-start-letter') as HTMLInputElement;
  const cbReadable = document.getElementById('opt-readable') as HTMLInputElement;
  const cbUnique = document.getElementById('opt-unique') as HTMLInputElement;
  const cbExcludeSimilar = document.getElementById('opt-exclude-similar') as HTMLInputElement;
  const pwDisplay = document.getElementById('pw-display') as HTMLElement;
  const btnCopy = document.getElementById('btn-copy') as HTMLButtonElement;
  const copyLabel = document.getElementById('copy-label') as HTMLSpanElement;
  const iconCopy = document.getElementById('icon-copy') as HTMLElement;
  const iconCheck = document.getElementById('icon-check') as HTMLElement;
  const btnGenerate = document.getElementById('btn-generate') as HTMLButtonElement;
  const strengthText = document.getElementById('strength-text') as HTMLElement;
  const strengthDetail = document.getElementById('strength-detail') as HTMLElement;
  const strengthBar = document.getElementById('strength-bar') as HTMLElement;
  const segments = [
    document.getElementById('seg1'),
    document.getElementById('seg2'),
    document.getElementById('seg3'),
    document.getElementById('seg4'),
  ];
  const btnQrToggle = document.getElementById('btn-qr-toggle') as HTMLButtonElement;
  const qrBtnLabel = document.getElementById('qr-btn-label') as HTMLSpanElement;
  const qrContainer = document.getElementById('qr-container') as HTMLElement;
  const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
  const btnDownloadQr = document.getElementById('btn-download-qr') as HTMLButtonElement;
  const pgWarning = document.getElementById('pg-warning') as HTMLElement;
  const advancedToggle = document.getElementById('advanced-toggle') as HTMLButtonElement;
  const advancedContent = document.getElementById('advanced-content') as HTMLElement;

  let currentPassword = '';
  let qrInstance: any = null;

  function getOptions(): GenOptions {
    return {
      length: parseInt(lenSlider.value, 10),
      uppercase: cbUppercase.checked,
      lowercase: cbLowercase.checked,
      numbers: cbNumbers.checked,
      symbols: cbSymbols.checked,
      customSymbols: inputCustomSymbols.value,
      startWithLetter: cbStartLetter ? cbStartLetter.checked : false,
      readable: cbReadable.checked,
      unique: cbUnique.checked,
      excludeSimilar: cbExcludeSimilar.checked,
    };
  }

  async function renderQR(text: string) {
    if (!text) return;
    try {
      await loadQRLib();
      const qr = (window as any).QRCode;
      if (!qr) return;

      const ctx = qrCanvas.getContext('2d');
      if (ctx) ctx.clearRect(0, 0, qrCanvas.width, qrCanvas.height);

      if (qrInstance) {
        try { qrInstance.clear(); } catch(e) {}
        qrInstance = null;
      }

      const tempDiv = document.createElement('div');
      tempDiv.style.display = 'none';
      document.body.appendChild(tempDiv);

      qrInstance = new qr(tempDiv, {
        text: text,
        width: 120,
        height: 120,
        colorDark: '#000000',
        colorLight: '#ffffff',
        correctLevel: qr.CorrectLevel.M,
      });

      setTimeout(() => {
        const img = tempDiv.querySelector('img') as HTMLImageElement;
        const canvas = tempDiv.querySelector('canvas') as HTMLCanvasElement;

        if (canvas) {
          qrCanvas.width = 120;
          qrCanvas.height = 120;
          const ctx2 = qrCanvas.getContext('2d');
          if (ctx2) ctx2.drawImage(canvas, 0, 0);
        } else if (img && img.src) {
          const image = new Image();
          image.onload = () => {
            qrCanvas.width = 120;
            qrCanvas.height = 120;
            const ctx2 = qrCanvas.getContext('2d');
            if (ctx2) ctx2.drawImage(image, 0, 0, 120, 120);
          };
          image.src = img.src;
        }
        document.body.removeChild(tempDiv);
      }, 100);

    } catch (e) {
      console.warn('QR generation failed:', e);
    }
  }

  function generate() {
    const opts = getOptions();
    const pw = generatePassword(opts);

    if (pw === null) {
      pwDisplay.textContent = '';
      pgWarning.hidden = false;
      updateStrength('', opts);
      if (!qrContainer.hidden) renderQR('');
      return;
    }

    pgWarning.hidden = true;
    currentPassword = pw;
    pwDisplay.textContent = pw;
    updateStrength(pw, opts);
    if (!qrContainer.hidden) renderQR(pw);
  }

  function updateStrength(pw: string, opts: GenOptions) {
    if (!pw) {
      strengthText.textContent = '—';
      strengthText.className = 'pg-strength-text';
      strengthDetail.textContent = '';
      strengthBar.setAttribute('aria-valuenow', '0');
      segments.forEach(s => {
        if (s) { s.className = 'strength-segment'; }
      });
      return;
    }

    const entropy = calcEntropy(pw, opts);
    const level = getStrengthLevel(entropy);
    const segCount = STRENGTH_SEGMENTS[level];

    strengthText.textContent = STRENGTH_LABELS[level];
    strengthText.className = `pg-strength-text strength-${level}`;
    strengthDetail.textContent = `(${entropy.toFixed(1)} bits)`;
    strengthBar.setAttribute('aria-valuenow', String(segCount));

    segments.forEach((s, i) => {
      if (s) {
        s.className = `strength-segment ${i < segCount ? `seg-${level}` : ''}`;
      }
    });
  }

  // Generation Triggers
  lenSlider?.addEventListener('input', () => {
    lenDisplay.textContent = lenSlider.value;
    lenSlider.setAttribute('aria-valuenow', lenSlider.value);
    generate();
  });

  const optionInputs = [
    cbUppercase, cbLowercase, cbNumbers, cbSymbols,
    cbStartLetter, cbReadable, cbUnique, cbExcludeSimilar
  ];
  optionInputs.forEach(el => el?.addEventListener('change', generate));
  inputCustomSymbols?.addEventListener('input', generate);

  btnGenerate?.addEventListener('click', generate);

  // Non-Regenerating Action Handlers
  let copyTimeout: ReturnType<typeof setTimeout>;
  btnCopy?.addEventListener('click', async () => {
    if (!currentPassword) return;
    try {
      await navigator.clipboard.writeText(currentPassword);
      
      if (iconCopy) iconCopy.style.display = 'none';
      if (iconCheck) iconCheck.style.display = 'block';
      if (copyLabel) copyLabel.textContent = 'Copied!';
      btnCopy.classList.add('copied');
      btnCopy.setAttribute('aria-label', 'Password copied to clipboard');

      clearTimeout(copyTimeout);
      copyTimeout = setTimeout(() => {
        if (iconCopy) iconCopy.style.display = 'block';
        if (iconCheck) iconCheck.style.display = 'none';
        if (copyLabel) copyLabel.textContent = 'Copy';
        btnCopy.classList.remove('copied');
        btnCopy.setAttribute('aria-label', 'Copy password to clipboard');
      }, 1500);
    } catch (e) {
      const range = document.createRange();
      range.selectNodeContents(pwDisplay);
      const sel = window.getSelection();
      if (sel) {
        sel.removeAllRanges();
        sel.addRange(range);
      }
    }
  });

  // QR toggle
  btnQrToggle?.addEventListener('click', () => {
    const isShowing = !qrContainer.hidden;
    qrContainer.hidden = isShowing;
    btnQrToggle.setAttribute('aria-expanded', String(!isShowing));
    btnQrToggle.classList.toggle('active', !isShowing);
    if (qrBtnLabel) {
      qrBtnLabel.textContent = !isShowing ? 'Hide QR' : 'QR';
    }
    if (!isShowing && currentPassword) {
      renderQR(currentPassword);
    }
  });

  // Download QR
  btnDownloadQr?.addEventListener('click', () => {
    if (!qrCanvas) return;
    const link = document.createElement('a');
    link.download = 'password-qr.jpg';
    link.href = qrCanvas.toDataURL('image/jpeg', 0.92);
    link.click();
  });

  // Advanced options accordion
  advancedToggle?.addEventListener('click', () => {
    const isOpen = advancedContent.hidden;
    advancedContent.hidden = !isOpen;
    advancedToggle.setAttribute('aria-expanded', String(isOpen));
  });

  // FAQ accordion
  document.querySelectorAll<HTMLButtonElement>('.accordion-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const contentId = trigger.getAttribute('aria-controls');
      if (!contentId) return;
      const content = document.getElementById(contentId) as HTMLElement;
      if (!content) return;
      const isOpen = !content.hidden;
      content.hidden = isOpen;
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // Init
  generate();
</script>
