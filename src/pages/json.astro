---
import Layout from "../layouts/Layout.astro";
import JsonToolkit from "../components/JsonToolkit.astro";

const jsonLdWebApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://thedevelopertools.com/json#webapp",
  "name": "JSON Formatter, Validator & Developer Toolkit",
  "url": "https://thedevelopertools.com/json",
  "description": "Free, browser-based JSON toolkit. Format, validate, minify, view, and convert JSON to CSV, YAML, XML, TypeScript, Zod, and Pydantic. 100% private and client-side.",
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "JSON Utilities",
  "operatingSystem": "All (Modern Web Browser)",
  "browserRequirements": "Requires JavaScript enabled. Works offline after loading.",
  "softwareVersion": "1.2",
  "inLanguage": "en",
  "publisher": {
    "@type": "Organization",
    "name": "The Developer Tools",
    "url": "https://thedevelopertools.com"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "JSON Formatter with 2-space, 4-space, and tab indentation",
    "JSON Viewer with hierarchical collapsible tree and type highlighting",
    "JSON Search with real-time key and value matching",
    "JSON Validator with line and column error reporting",
    "JSON Minifier for payload size compression",
    "JSON Compare side-by-side visual difference viewer",
    "JSON to CSV converter for spreadsheet imports",
    "JSON to YAML converter for DevOps configurations",
    "JSON to XML markup converter",
    "JSON to TypeScript interface generator",
    "JSON to Zod runtime validation schema generator",
    "JSON Schema draft-07 generator",
    "JSON to OpenAPI 3.0 schema generator",
    "JSON to Go structs generator",
    "JSON to Python Pydantic v2 models generator",
    "JSON to Java Jackson POJO generator",
    "JSON to Kotlin data classes generator",
    "100% client-side execution with zero telemetry"
  ]
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://thedevelopertools.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "JSON Tools",
      "item": "https://thedevelopertools.com/json"
    }
  ]
};

const jsonLdFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is this JSON formatter free and private?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every tool in this suite runs locally in your browser using JavaScript. Data is never sent to a server, logged, or tracked. Once loaded, the page works completely offline."
      }
    },
    {
      "@type": "Question",
      "name": "What operations are included in this JSON toolkit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The toolkit includes a JSON Formatter (beautifier), Minifier, Validator with line and column syntax errors, Tree Viewer, side-by-side Compare, converters for CSV, YAML, and XML, and code generators for TypeScript, Zod, JSON Schema, OpenAPI, Go, Python Pydantic, Java, and Kotlin."
      }
    },
    {
      "@type": "Question",
      "name": "How does the validator calculate error line numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The validator parses the input with the browser native JSON.parse() implementation, extracts the character offset from parse exceptions, and calculates the exact line and column coordinates."
      }
    },
    {
      "@type": "Question",
      "name": "Can I load files without pasting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can click Import or drag and drop any .json file onto the editor. The file is read locally via the browser FileReader API without network upload."
      }
    }
  ]
};
---

<Layout
  title="JSON Formatter, Validator & Toolkit — Fast, Private Online JSON Tools"
  description="Format, validate, minify, and convert JSON to TypeScript, Zod, CSV, YAML, and Pydantic. Runs 100% in your browser with zero data collection."
  canonicalUrl="https://thedevelopertools.com/json"
  ogTitle="JSON Formatter, Validator & Toolkit — Free Online JSON Tools"
  ogDescription="Format, validate, minify, view, and convert JSON to TypeScript, Zod, CSV, YAML, and more in a unified workspace. 100% client-side."
  ogImageAlt="The Developer Tools — Free Online JSON Toolkit"
  jsonLd={[jsonLdWebApp, jsonLdBreadcrumbs, jsonLdFAQ]}
>
  <main id="main-content" class="jt-page">
    <div class="jt-page-column">

      <!-- Breadcrumbs -->
      <nav class="pg-breadcrumbs" aria-label="Breadcrumb">
        <ol class="pg-breadcrumb-list">
          <li class="pg-breadcrumb-item"><a href="/" class="pg-breadcrumb-link">Home</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><span class="pg-breadcrumb-current" aria-current="page">JSON Tools</span></li>
        </ol>
      </nav>

      <!-- Page header -->
      <header class="jt-page-header">
        <div class="jt-page-header-inner">
          <span class="eyebrow jt-header-eyebrow">100% CLIENT-SIDE · NO DATA LEAVES YOUR BROWSER</span>
          <h1 class="jt-page-title">JSON Toolkit</h1>
          <p class="jt-page-sub">
            Format, validate, minify, explore, and convert JSON in a unified workspace.
            Paste your data once and switch between operations instantly.
          </p>
        </div>
      </header>

      <!-- The JSON Toolkit workspace -->
      <JsonToolkit />

      <!-- SEO Article & Reference Documentation -->
      <article class="seo-article" aria-label="JSON Tools Documentation and Reference">
        <header class="seo-article-header">
          <span class="eyebrow">Technical Reference</span>
          <h2 class="seo-article-title">Browser-Based JSON Formatting, Validation, and Type Generation</h2>
        </header>

        <div class="seo-article-content">
          <p>
            JSON (JavaScript Object Notation, RFC 8259) is the standard data interchange format for web APIs, configuration files, and document stores. This toolkit provides client-side utilities for inspecting, cleaning, formatting, and converting JSON payloads without sending data over the network. You can explore all available tools on <a href="/" class="seo-link">The Developer Tools</a> homepage.
          </p>

          <h3><a href="/json/formatter" class="seo-link">JSON Formatter and Beautifier</a></h3>
          <p>
            Minified or unformatted API payloads are difficult to inspect during debugging. The <a href="/json/formatter" class="seo-link">JSON formatter</a> parses raw text and re-serializes it with 2-space, 4-space, or tab indentation. It runs immediately in the browser, making large payloads readable without round-trip network delays.
          </p>

          <h3><a href="/json/validator" class="seo-link">JSON Validator and Syntax Checker</a></h3>
          <p>
            Syntax issues such as trailing commas, single quotes around keys, unescaped control characters, or missing brackets prevent parsers from reading data. The <a href="/json/validator" class="seo-link">JSON validator</a> identifies parse failures, extracts character positions from parser exceptions, and maps them to exact line and column numbers.
          </p>

          <h3><a href="/json/minifier" class="seo-link">JSON Minifier and Whitespace Compressor</a></h3>
          <p>
            The <a href="/json/minifier" class="seo-link">JSON minifier</a> strips unnecessary whitespace, newlines, and indentation while preserving string values and escape sequences. This reduces payload size for production HTTP responses, embedded configuration files, and network bandwidth constraints.
          </p>

          <h3><a href="/json/viewer" class="seo-link">Hierarchical JSON Tree Viewer</a></h3>
          <p>
            Deeply nested structures can be hard to follow in a flat text editor. The <a href="/json/viewer" class="seo-link">JSON tree viewer</a> renders objects and arrays as collapsible nodes with color-coded data types (strings, numbers, booleans, arrays, objects, and null). Quick controls allow expanding or collapsing the entire hierarchy at once.
          </p>

          <h3><a href="/json/compare" class="seo-link">Side-by-Side JSON Diff and Comparison</a></h3>
          <p>
            The <a href="/json/compare" class="seo-link">JSON comparison tool</a> highlights structural and value differences between two JSON documents. It normalizes formatting before diffing so whitespace differences do not obscure actual data changes, flagging added, modified, and removed keys clearly.
          </p>

          <h3>Code and Schema Generators</h3>
          <p>
            Translating JSON into application code often involves repetitive boilerplate. The toolkit infers types directly from real JSON payloads:
          </p>
          <ul>
            <li><strong><a href="/json/to-typescript" class="seo-link">JSON to TypeScript:</a></strong> Generates nested interfaces with accurate optional and primitive typing.</li>
            <li><strong><a href="/json/to-zod" class="seo-link">JSON to Zod:</a></strong> Outputs runtime schemas using <code>z.object()</code>, <code>z.array()</code>, and primitive validators.</li>
            <li><strong><a href="/json/to-json-schema" class="seo-link">JSON Schema (draft-07):</a></strong> Produces schema definitions compatible with validation libraries such as Ajv.</li>
            <li><strong><a href="/json/to-openapi" class="seo-link">OpenAPI 3.0:</a></strong> Generates reusable schema components for API documentation.</li>
            <li><strong><a href="/json/to-pydantic" class="seo-link">Python Pydantic:</a></strong> Produces Pydantic v2 <code>BaseModel</code> classes with type hints.</li>
            <li><strong><a href="/json/to-go" class="seo-link">Go Structs:</a></strong> Generates idiomatic Go structs with <code>`json:"..."`</code> struct tags.</li>
            <li><strong><a href="/json/to-java" class="seo-link">Java POJO:</a></strong> Generates Java classes with Jackson annotations.</li>
            <li><strong><a href="/json/to-kotlin" class="seo-link">Kotlin:</a></strong> Produces data classes with kotlinx.serialization annotations.</li>
          </ul>

          <h3>Data Converters: CSV, YAML, and XML</h3>
          <p>
            Convert structured data between common formats:
          </p>
          <ul>
            <li><strong><a href="/json/to-csv" class="seo-link">JSON to CSV:</a></strong> Extracts keys from arrays of objects to build header rows and escaped comma-separated data for spreadsheet import.</li>
            <li><strong><a href="/json/to-yaml" class="seo-link">JSON to YAML:</a></strong> Converts data into clean YAML for Docker Compose, Kubernetes manifests, and CI/CD pipelines.</li>
            <li><strong><a href="/json/to-xml" class="seo-link">JSON to XML:</a></strong> Converts objects and arrays into structured XML documents.</li>
          </ul>

          <h3>Client-Side Privacy Architecture</h3>
          <p>
            JSON payloads frequently contain proprietary schemas, customer records, environment variables, or API tokens. Every tool in this suite executes locally using browser JavaScript and Web APIs (such as <code>FileReader</code>). Inspecting the browser network panel confirms zero outbound requests during data processing.
          </p>
        </div>

        <p class="pg-csprng-note" role="contentinfo">
          100% Client-Side Engine · Zero Network Telemetry · Native Browser JavaScript
        </p>
      </article>

    </div>
  </main>
</Layout>

<style>
  .jt-page {
    padding: 24px 0 80px;
    width: 100%;
  }

  /* Wide column — wider than password generator to fit 2-col workspace */
  .jt-page-column {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 20px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  /* Breadcrumbs */
  .pg-breadcrumbs { margin-bottom: 20px; }
  .pg-breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0; padding: 0;
    font-size: 13px;
    color: var(--c-mute);
  }
  .pg-breadcrumb-link { color: var(--c-body); text-decoration: none; transition: color 120ms ease; }
  .pg-breadcrumb-link:hover { color: var(--c-ink); }
  .pg-breadcrumb-separator { color: var(--c-faint); }
  .pg-breadcrumb-current { color: var(--c-ink); font-weight: 500; }

  /* Page header */
  .jt-page-header {
    width: 100%;
    margin-bottom: 20px;
    text-align: center;
  }

  .jt-page-header-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .jt-header-eyebrow { font-size: 11px; letter-spacing: 0.1em; }

  .jt-page-title {
    margin: 0;
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--c-ink);
  }

  .jt-page-sub {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--c-body);
    text-align: center;
    max-width: 540px;
  }

  /* SEO Article */
  .seo-article {
    width: 100%;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--c-hairline);
  }

  .seo-article-header { margin-bottom: 24px; }

  .seo-article-title {
    margin-top: 6px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--c-ink);
  }

  .seo-article-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 14px;
    line-height: 24px;
    color: var(--c-body);
    text-align: left;
  }

  .seo-article-content h2 {
    margin-top: 28px; margin-bottom: 10px;
    font-size: 18px; font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--c-ink);
  }

  .seo-article-content h3 {
    margin-top: 20px; margin-bottom: 6px;
    font-size: 15px; font-weight: 600;
    color: var(--c-ink);
  }

  .seo-article-content p { margin: 0; }

  .seo-article-content strong { color: var(--c-ink); font-weight: 600; }

  .seo-article-content code {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: var(--c-hairline-soft);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--c-hairline);
    color: var(--c-ink);
  }

  .seo-link {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 120ms ease;
  }

  .seo-link:hover { color: var(--c-ink); }

  .pg-csprng-note {
    margin: 28px 0 0;
    font-size: 11px;
    color: var(--c-mute);
    font-family: var(--font-mono);
    text-align: left;
  }

  @media (max-width: 640px) {
    .jt-page { padding: 16px 0 48px; }
    .jt-page-column { padding-inline: 14px; }
    .jt-page-sub { max-width: 100%; }
    .seo-article { margin-top: 36px; padding-top: 28px; }
    .jt-shortcuts { justify-content: flex-start; }
  }
</style>
