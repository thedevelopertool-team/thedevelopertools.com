---
import Layout from "../layouts/Layout.astro";
import ToolCard from "../components/ToolCard.astro";

const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "The Developer Tools",
  "url": "https://thedevelopertools.com",
  "description": "A hub of free, private, browser-based developer utilities. No backend, no data collection.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://thedevelopertools.com/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Tool definitions
const tools = [
  {
    name: "Password Generator",
    description: "Free strong random password generator online. Create secure, high-entropy passwords with custom symbols, readable mode, and instant QR export.",
    href: "/password-generator",
    category: "Security",
    status: "available" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  },
  {
    name: "JSON Formatter",
    description: "Format, validate, and minify JSON with syntax highlighting and error detection.",
    href: "#",
    category: "Formatters",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    name: "XML Formatter",
    description: "Format and validate XML documents with tree visualization and error highlighting.",
    href: "#",
    category: "Formatters",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="10" y1="13" x2="14" y2="13"/></svg>`,
  },
  {
    name: "HTML Formatter",
    description: "Beautify and minify HTML markup with configurable indentation and options.",
    href: "#",
    category: "Formatters",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  },
  {
    name: "Base64 Encoder",
    description: "Encode and decode strings and files to/from Base64 format instantly.",
    href: "#",
    category: "Converters",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`,
  },
  {
    name: "Regex Tester",
    description: "Test and debug regular expressions with real-time match highlighting and flags.",
    href: "#",
    category: "Developer",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  },
  {
    name: "UUID Generator",
    description: "Generate RFC-compliant UUIDs (v1, v4) in bulk with copy-to-clipboard.",
    href: "#",
    category: "Developer",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  },
  {
    name: "Hash Generator",
    description: "Compute MD5, SHA-1, SHA-256, SHA-512 hashes from text or file input.",
    href: "#",
    category: "Security",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>`,
  },
  {
    name: "URL Encoder",
    description: "Encode and decode URL components and query strings with character reference.",
    href: "#",
    category: "Converters",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  },
  {
    name: "Color Picker",
    description: "Pick, convert, and analyze colors between HEX, RGB, HSL, and HSV formats.",
    href: "#",
    category: "Design",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>`,
  },
  {
    name: "Cron Expression Parser",
    description: "Parse, validate, and generate cron expressions with human-readable descriptions.",
    href: "#",
    category: "Developer",
    status: "coming-soon" as const,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
];

const categories = ["All", "Security", "Formatters", "Converters", "Developer", "Design"];
---

<Layout
  title="The Developer Tools — Free Browser-Based Developer Utilities"
  description="A hub of free, private, client-side developer tools. Password generators, formatters, converters and more — all running 100% in your browser. No backend, no data collection."
  jsonLd={siteJsonLd}
>
  <main id="main-content">
    <!-- Hero Section -->
    <section class="hero-section" aria-label="Hero">
      <div class="container-site">
        <div class="hero-inner">
          <span class="eyebrow">The Developer Tools</span>
          <h1 class="hero-heading">
            Developer utilities.<br />
            <span class="hero-heading-accent">Private by design.</span>
          </h1>
          <p class="hero-sub">
            A growing collection of free browser-based tools for developers.
            Everything runs client-side — no servers, no data collection, no accounts.
          </p>

          <!-- Search -->
          <div class="hero-search-wrap">
            <label for="tool-search" class="sr-only">Search tools</label>
            <div class="search-box" role="search">
              <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input
                id="tool-search"
                type="search"
                class="search-input"
                placeholder="Search tools…"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search developer tools"
              />
            </div>
          </div>
        </div>
      </div>
      <!-- Hero mesh gradient decoration -->
      <div class="hero-gradient" aria-hidden="true"></div>
    </section>

    <!-- Tools Section -->
    <section class="tools-section" aria-label="Tool catalog">
      <div class="container-site">
        <!-- Category filter pills -->
        <div class="category-filter" role="group" aria-label="Filter tools by category">
          {categories.map((cat) => (
            <button
              class={`btn btn-pill-cat category-btn ${cat === 'All' ? 'active' : ''}`}
              data-category={cat}
              type="button"
              aria-pressed={cat === 'All' ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Tool count -->
        <p class="tools-count" id="tools-count" aria-live="polite">
          <span id="count-num">{tools.length}</span> tools
        </p>

        <!-- Tools grid -->
        <div class="tools-grid" id="tools-grid" role="list" aria-label="Developer tools">
          {tools.map((tool) => (
            <div
              class="tools-grid-item"
              data-name={tool.name.toLowerCase()}
              data-category={tool.category}
              role="listitem"
            >
              <ToolCard
                name={tool.name}
                description={tool.description}
                href={tool.href}
                icon={tool.icon}
                status={tool.status}
                category={tool.category}
              />
            </div>
          ))}
        </div>

        <!-- No results -->
        <div id="no-results" class="no-results" hidden aria-live="polite">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <p>No tools match your search.</p>
        </div>
      </div>
    </section>

    <!-- Privacy callout band -->
    <section class="privacy-band" aria-label="Privacy and security">
      <div class="container-site privacy-band-inner">
        <div class="privacy-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <div>
            <strong>100% Client-Side</strong>
            <span>All processing happens in your browser.</span>
          </div>
        </div>
        <div class="privacy-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <div>
            <strong>No Data Collection</strong>
            <span>Zero tracking, no analytics, no accounts.</span>
          </div>
        </div>
        <div class="privacy-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          <div>
            <strong>Works Offline</strong>
            <span>No network requests during tool execution.</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Skip link */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Hero */
  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 80px 0 64px;
    border-bottom: 1px solid var(--c-hairline);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-heading {
    margin: 0;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--c-ink);
  }

  .hero-heading-accent {
    background: linear-gradient(135deg, #007cf0 0%, #7928ca 50%, #ff0080 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    margin: 0;
    font-size: 16px;
    line-height: 26px;
    color: var(--c-body);
    max-width: 520px;
  }

  .hero-gradient {
    position: absolute;
    top: -120px;
    right: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(ellipse at center,
      rgba(0,124,240,0.08) 0%,
      rgba(121,40,202,0.06) 35%,
      rgba(255,0,128,0.04) 65%,
      transparent 80%
    );
    pointer-events: none;
  }

  /* Search */
  .hero-search-wrap {
    margin-top: 8px;
    max-width: 420px;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--c-mute);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    background-color: var(--c-canvas-elevated);
    color: var(--c-ink);
    border: 1px solid var(--c-hairline);
    border-radius: 8px;
    padding: 10px 12px 10px 38px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 20px;
    transition: border-color 120ms ease;
    appearance: none;
    -webkit-appearance: none;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--c-ink);
  }

  .search-input::placeholder {
    color: var(--c-faint);
  }

  /* Tools section */
  .tools-section {
    padding: 48px 0 80px;
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .tools-count {
    margin: 0 0 20px;
    font-size: 13px;
    color: var(--c-mute);
    font-family: var(--font-mono);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 64px 0;
    color: var(--c-mute);
    text-align: center;
  }

  .no-results p {
    margin: 0;
    font-size: 14px;
  }

  /* Privacy band */
  .privacy-band {
    border-top: 1px solid var(--c-hairline);
    padding: 40px 0;
    background-color: var(--c-canvas);
  }

  .privacy-band-inner {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .privacy-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
    min-width: 200px;
    color: var(--c-ink);
  }

  .privacy-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--c-mute);
  }

  .privacy-item div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .privacy-item strong {
    font-size: 13px;
    font-weight: 600;
    color: var(--c-ink);
  }

  .privacy-item span {
    font-size: 12px;
    color: var(--c-body);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 48px 0 40px;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .privacy-band-inner {
      flex-direction: column;
      gap: 24px;
    }
  }
</style>

<script>
  // Search filtering
  const searchInput = document.getElementById('tool-search') as HTMLInputElement;
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const gridItems = document.querySelectorAll<HTMLElement>('.tools-grid-item');
  const noResults = document.getElementById('no-results');
  const countNum = document.getElementById('count-num');

  let activeCategory = 'All';
  let searchQuery = '';

  function filterTools() {
    let visible = 0;
    gridItems.forEach((item) => {
      const name = item.dataset.name || '';
      const category = item.dataset.category || '';
      const matchesSearch = searchQuery === '' || name.includes(searchQuery.toLowerCase());
      const matchesCategory = activeCategory === 'All' || category === activeCategory;
      const show = matchesSearch && matchesCategory;
      item.hidden = !show;
      if (show) visible++;
    });

    if (countNum) countNum.textContent = String(visible);
    if (noResults) noResults.hidden = visible > 0;
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    filterTools();
  });

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category || 'All';
      categoryBtns.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      filterTools();
    });
  });
</script>
