---
import Layout from "../../layouts/Layout.astro";
import JsonToolkit from "../../components/JsonToolkit.astro";

const jsonLdWebApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://thedevelopertools.com/json/formatter#webapp",
  "name": "JSON Formatter & Beautifier",
  "url": "https://thedevelopertools.com/json/formatter",
  "description": "Free online JSON formatter and beautifier. Pretty-print raw or minified JSON with configurable 2-space, 4-space, or tab indentation. 100% private in-browser tool.",
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "JSON Utilities",
  "operatingSystem": "All (Modern Web Browser)",
  "browserRequirements": "Requires JavaScript enabled",
  "softwareVersion": "1.2",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Developer Tools",
    "url": "https://thedevelopertools.com"
  }
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://thedevelopertools.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "JSON Tools",
      "item": "https://thedevelopertools.com/json"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "JSON Formatter",
      "item": "https://thedevelopertools.com/json/formatter"
    }
  ]
};

const jsonLdFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I format minified JSON online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Paste your minified JSON string into the input box or drop a .json file. The formatter immediately parses the data and displays a clean, indented version using 2 spaces, 4 spaces, or tabs based on your toolbar selection."
      }
    },
    {
      "@type": "Question",
      "name": "Does formatting JSON expose my data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. All formatting logic runs inside your web browser using JavaScript. No payload data is sent across the network or stored on remote servers."
      }
    },
    {
      "@type": "Question",
      "name": "What indentation options are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can format JSON using 2 spaces (standard for JavaScript and web applications), 4 spaces (common in Python and backend services), or tab characters."
      }
    }
  ]
};
---

<Layout
  title="JSON Formatter & Beautifier — Pretty Print JSON Online (Free & Private)"
  description="Format, beautify, and pretty-print JSON online with 2-space, 4-space, or tab indentation. Fast, secure, and runs 100% in your browser."
  canonicalUrl="https://thedevelopertools.com/json/formatter"
  ogTitle="JSON Formatter & Beautifier — Free Online Developer Tool"
  ogDescription="Beautify unformatted or minified JSON with customizable indentation. Private, client-side, zero network calls."
  ogImageAlt="JSON Formatter and Beautifier Tool"
  jsonLd={[jsonLdWebApp, jsonLdBreadcrumbs, jsonLdFAQ]}
>
  <main id="main-content" class="jt-page">
    <div class="jt-page-column">

      <!-- Breadcrumbs -->
      <nav class="pg-breadcrumbs" aria-label="Breadcrumb">
        <ol class="pg-breadcrumb-list">
          <li class="pg-breadcrumb-item"><a href="/" class="pg-breadcrumb-link">Home</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><a href="/json" class="pg-breadcrumb-link">JSON Tools</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><span class="pg-breadcrumb-current" aria-current="page">JSON Formatter</span></li>
        </ol>
      </nav>

      <!-- Page header -->
      <header class="jt-page-header">
        <div class="jt-page-header-inner">
          <span class="eyebrow jt-header-eyebrow">CLIENT-SIDE JSON BEAUTIFIER · NO NETWORK REQUESTS</span>
          <h1 class="jt-page-title">JSON Formatter &amp; Beautifier</h1>
          <p class="jt-page-sub">
            Beautify, indent, and pretty-print raw JSON payloads. Choose between 2 spaces, 4 spaces, or tab indentation.
          </p>
        </div>
      </header>

      <!-- JSON Toolkit workspace initialized to Formatter tab -->
      <JsonToolkit initialTab="formatter" />

      <!-- Technical Documentation Article -->
      <article class="seo-article" aria-label="JSON Formatter Documentation">
        <header class="seo-article-header">
          <span class="eyebrow">Technical Reference</span>
          <h2 class="seo-article-title">How Online JSON Formatting and Pretty-Printing Works</h2>
        </header>

        <div class="seo-article-content">
          <p>
            When web APIs respond with compressed JSON payloads, all whitespace and indentation are stripped to save bandwidth. While efficient for machines, minified strings are difficult for engineers to inspect during debugging. A <strong>JSON formatter</strong> takes raw JSON text, parses the structure into an in-memory object hierarchy, and serializes it back to a readable string with consistent line breaks and indentation levels.
          </p>

          <h3>Indentation Standards: 2 Spaces vs 4 Spaces vs Tabs</h3>
          <p>
            Different development ecosystems follow different formatting conventions:
          </p>
          <ul>
            <li><strong>2 Spaces:</strong> The standard across JavaScript, TypeScript, React, Vue, and modern frontend ecosystems. It minimizes horizontal scrolling when viewing deeply nested payloads.</li>
            <li><strong>4 Spaces:</strong> Preferred in Python, Java, and C# codebases where higher visual contrast between nesting levels is standard.</li>
            <li><strong>Tabs:</strong> Useful for accessibility, allowing individual engineers to set their preferred tab width in their editor.</li>
          </ul>

          <h3>Client-Side Processing and Data Privacy</h3>
          <p>
            Many developer utilities send pasted JSON to remote servers for processing. This creates security compliance issues when working with proprietary payloads, JWTs, customer data, or internal API responses. This formatter executes purely inside your browser using the native JavaScript runtime. Data never leaves your machine.
          </p>

          <h3>Related JSON Utilities</h3>
          <p>
            Need to run other operations on your JSON? Use the tabs above or navigate directly to related tools:
          </p>
          <ul>
            <li><a href="/json/validator" class="seo-link">JSON Validator</a>: Pinpoint syntax errors with line and column numbers.</li>
            <li><a href="/json/minifier" class="seo-link">JSON Minifier</a>: Compress formatted JSON for production deployment.</li>
            <li><a href="/json/viewer" class="seo-link">JSON Tree Viewer</a>: Inspect large structures in an interactive collapsible tree.</li>
            <li><a href="/json/to-typescript" class="seo-link">JSON to TypeScript</a>: Infer interfaces and types from sample data.</li>
          </ul>
        </div>

        <p class="pg-csprng-note" role="contentinfo">
          100% Client-Side Engine · Zero Network Telemetry · Native Browser JavaScript
        </p>
      </article>

    </div>
  </main>
</Layout>

<style>
  .jt-page { padding: 24px 0 80px; width: 100%; }
  .jt-page-column {
    width: 100%; max-width: 1080px; margin-inline: auto; padding-inline: 20px;
    display: flex; flex-direction: column; align-items: stretch;
  }
  .pg-breadcrumbs { margin-bottom: 20px; }
  .pg-breadcrumb-list {
    display: flex; align-items: center; gap: 8px; list-style: none; margin: 0; padding: 0;
    font-size: 13px; color: var(--c-mute);
  }
  .pg-breadcrumb-link { color: var(--c-body); text-decoration: none; transition: color 120ms ease; }
  .pg-breadcrumb-link:hover { color: var(--c-ink); }
  .pg-breadcrumb-separator { color: var(--c-faint); }
  .pg-breadcrumb-current { color: var(--c-ink); font-weight: 500; }
  .jt-page-header { width: 100%; margin-bottom: 20px; text-align: center; }
  .jt-page-header-inner { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .jt-header-eyebrow { font-size: 11px; letter-spacing: 0.1em; }
  .jt-page-title {
    margin: 0; font-size: clamp(28px, 4vw, 36px); font-weight: 600; line-height: 1.15;
    letter-spacing: -0.03em; color: var(--c-ink);
  }
  .jt-page-sub { margin: 0; font-size: 14px; line-height: 22px; color: var(--c-body); text-align: center; max-width: 540px; }
  .seo-article { width: 100%; margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--c-hairline); }
  .seo-article-header { margin-bottom: 24px; }
  .seo-article-title { margin-top: 6px; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--c-ink); }
  .seo-article-content { display: flex; flex-direction: column; gap: 16px; font-size: 14px; line-height: 24px; color: var(--c-body); text-align: left; }
  .seo-article-content h2 { margin-top: 28px; margin-bottom: 10px; font-size: 18px; font-weight: 600; color: var(--c-ink); }
  .seo-article-content h3 { margin-top: 20px; margin-bottom: 6px; font-size: 15px; font-weight: 600; color: var(--c-ink); }
  .seo-article-content p { margin: 0; }
  .seo-article-content strong { color: var(--c-ink); font-weight: 600; }
  .seo-article-content ul { margin: 0; padding-left: 20px; }
  .seo-article-content li { margin-bottom: 6px; }
  .seo-link { color: var(--c-link); text-decoration: underline; text-underline-offset: 2px; }
  .seo-link:hover { color: var(--c-ink); }
  .pg-csprng-note { margin: 28px 0 0; font-size: 11px; color: var(--c-mute); font-family: var(--font-mono); }
  @media (max-width: 640px) {
    .jt-page { padding: 16px 0 48px; }
    .jt-page-column { padding-inline: 14px; }
    .seo-article { margin-top: 36px; padding-top: 28px; }
  }
</style>
