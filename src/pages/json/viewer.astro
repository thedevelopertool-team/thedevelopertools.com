---
import Layout from "../../layouts/Layout.astro";
import JsonToolkit from "../../components/JsonToolkit.astro";

const jsonLdWebApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://thedevelopertools.com/json/viewer#webapp",
  "name": "JSON Tree Viewer & Visualizer",
  "url": "https://thedevelopertools.com/json/viewer",
  "description": "Free online JSON tree viewer. Explore nested JSON objects and arrays in an interactive, collapsible hierarchical tree with syntax highlighting.",
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "JSON Utilities",
  "operatingSystem": "All (Modern Web Browser)",
  "browserRequirements": "Requires JavaScript enabled",
  "softwareVersion": "1.2",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Developer Tools",
    "url": "https://thedevelopertools.com"
  }
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://thedevelopertools.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "JSON Tools",
      "item": "https://thedevelopertools.com/json"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "JSON Viewer",
      "item": "https://thedevelopertools.com/json/viewer"
    }
  ]
};

const jsonLdFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the JSON tree viewer work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The tree viewer parses your JSON and creates a collapsible visual node structure. You can expand and collapse individual branches, search keys and values, or expand/collapse the entire hierarchy with one click."
      }
    },
    {
      "@type": "Question",
      "name": "Are nested arrays and objects color-coded by type?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Strings, numbers, booleans, arrays, objects, and null values each receive distinct syntax coloring for immediate visual clarity."
      }
    }
  ]
};
---

<Layout
  title="JSON Viewer & Tree Visualizer — Explore JSON Hierarchies Online"
  description="Interactive JSON tree viewer. Explore deeply nested objects and arrays with collapsible nodes and type-aware color coding. 100% private."
  canonicalUrl="https://thedevelopertools.com/json/viewer"
  ogTitle="JSON Viewer & Tree Visualizer — Free Online Developer Tool"
  ogDescription="Explore complex JSON structures in a collapsible, interactive tree. In-browser rendering with zero server telemetry."
  ogImageAlt="JSON Tree Viewer Tool"
  jsonLd={[jsonLdWebApp, jsonLdBreadcrumbs, jsonLdFAQ]}
>
  <main id="main-content" class="jt-page">
    <div class="jt-page-column">

      <!-- Breadcrumbs -->
      <nav class="pg-breadcrumbs" aria-label="Breadcrumb">
        <ol class="pg-breadcrumb-list">
          <li class="pg-breadcrumb-item"><a href="/" class="pg-breadcrumb-link">Home</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><a href="/json" class="pg-breadcrumb-link">JSON Tools</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><span class="pg-breadcrumb-current" aria-current="page">JSON Tree Viewer</span></li>
        </ol>
      </nav>

      <!-- Page header -->
      <header class="jt-page-header">
        <div class="jt-page-header-inner">
          <span class="eyebrow jt-header-eyebrow">HIERARCHICAL TREE VISUALIZER · COLLAPSIBLE NODES</span>
          <h1 class="jt-page-title">JSON Viewer &amp; Tree Visualizer</h1>
          <p class="jt-page-sub">
            Navigate complex, deeply nested JSON payloads in an expandable hierarchical tree with data type color coding.
          </p>
        </div>
      </header>

      <!-- JSON Toolkit workspace initialized to Viewer tab -->
      <JsonToolkit initialTab="viewer" />

      <!-- Technical Documentation Article -->
      <article class="seo-article" aria-label="JSON Viewer Documentation">
        <header class="seo-article-header">
          <span class="eyebrow">Technical Reference</span>
          <h2 class="seo-article-title">Visualizing and Exploring Complex JSON Hierarchies</h2>
        </header>

        <div class="seo-article-content">
          <p>
            When working with API responses that span hundreds or thousands of nested lines, flat text representations make identifying structural relationships difficult. A <strong>JSON tree viewer</strong> converts data into an interactive Document Object Model (DOM) tree where every object and array is an expandable branch.
          </p>

          <h3>Interactive Tree Navigation and Search</h3>
          <p>
            Use toolbar controls to streamline inspection:
          </p>
          <ul>
            <li><strong>Expand and Collapse:</strong> Click individual object or array badges to toggle specific branches, or use global Expand All and Collapse All buttons.</li>
            <li><strong>Type Highlighting:</strong> Primitives (strings, numbers, booleans, null) and complex types (objects, arrays) are visually distinct to simplify schema comprehension.</li>
            <li><strong>Real-Time Search:</strong> Use the search bar to locate specific keys or values across deeply nested levels.</li>
          </ul>

          <h3>Related JSON Utilities</h3>
          <ul>
            <li><a href="/json/formatter" class="seo-link">JSON Formatter</a>: Indent raw payloads for text editors.</li>
            <li><a href="/json/compare" class="seo-link">JSON Compare</a>: Inspect differences between two JSON objects side by side.</li>
            <li><a href="/json/to-typescript" class="seo-link">JSON to TypeScript</a>: Convert inspected structures into strongly typed interfaces.</li>
          </ul>
        </div>

        <p class="pg-csprng-note" role="contentinfo">
          100% Client-Side Engine · Zero Network Telemetry · Native Browser JavaScript
        </p>
      </article>

    </div>
  </main>
</Layout>

<style>
  .jt-page { padding: 24px 0 80px; width: 100%; }
  .jt-page-column {
    width: 100%; max-width: 1080px; margin-inline: auto; padding-inline: 20px;
    display: flex; flex-direction: column; align-items: stretch;
  }
  .pg-breadcrumbs { margin-bottom: 20px; }
  .pg-breadcrumb-list {
    display: flex; align-items: center; gap: 8px; list-style: none; margin: 0; padding: 0;
    font-size: 13px; color: var(--c-mute);
  }
  .pg-breadcrumb-link { color: var(--c-body); text-decoration: none; transition: color 120ms ease; }
  .pg-breadcrumb-link:hover { color: var(--c-ink); }
  .pg-breadcrumb-separator { color: var(--c-faint); }
  .pg-breadcrumb-current { color: var(--c-ink); font-weight: 500; }
  .jt-page-header { width: 100%; margin-bottom: 20px; text-align: center; }
  .jt-page-header-inner { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .jt-header-eyebrow { font-size: 11px; letter-spacing: 0.1em; }
  .jt-page-title {
    margin: 0; font-size: clamp(28px, 4vw, 36px); font-weight: 600; line-height: 1.15;
    letter-spacing: -0.03em; color: var(--c-ink);
  }
  .jt-page-sub { margin: 0; font-size: 14px; line-height: 22px; color: var(--c-body); text-align: center; max-width: 540px; }
  .seo-article { width: 100%; margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--c-hairline); }
  .seo-article-header { margin-bottom: 24px; }
  .seo-article-title { margin-top: 6px; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--c-ink); }
  .seo-article-content { display: flex; flex-direction: column; gap: 16px; font-size: 14px; line-height: 24px; color: var(--c-body); text-align: left; }
  .seo-article-content h2 { margin-top: 28px; margin-bottom: 10px; font-size: 18px; font-weight: 600; color: var(--c-ink); }
  .seo-article-content h3 { margin-top: 20px; margin-bottom: 6px; font-size: 15px; font-weight: 600; color: var(--c-ink); }
  .seo-article-content p { margin: 0; }
  .seo-article-content strong { color: var(--c-ink); font-weight: 600; }
  .seo-article-content ul { margin: 0; padding-left: 20px; }
  .seo-article-content li { margin-bottom: 6px; }
  .seo-link { color: var(--c-link); text-decoration: underline; text-underline-offset: 2px; }
  .seo-link:hover { color: var(--c-ink); }
  .pg-csprng-note { margin: 28px 0 0; font-size: 11px; color: var(--c-mute); font-family: var(--font-mono); }
  @media (max-width: 640px) {
    .jt-page { padding: 16px 0 48px; }
    .jt-page-column { padding-inline: 14px; }
    .seo-article { margin-top: 36px; padding-top: 28px; }
  }
</style>
