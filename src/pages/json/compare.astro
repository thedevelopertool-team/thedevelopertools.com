---
import Layout from "../../layouts/Layout.astro";
import JsonToolkit from "../../components/JsonToolkit.astro";

const jsonLdWebApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://thedevelopertools.com/json/compare#webapp",
  "name": "JSON Diff & Comparison Tool",
  "url": "https://thedevelopertools.com/json/compare",
  "description": "Free online JSON diff tool. Compare two JSON payloads side by side, inspect additions, deletions, and modifications with color-coded syntax highlighting.",
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "JSON Utilities",
  "operatingSystem": "All (Modern Web Browser)",
  "browserRequirements": "Requires JavaScript enabled",
  "softwareVersion": "1.2",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Developer Tools",
    "url": "https://thedevelopertools.com"
  }
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://thedevelopertools.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "JSON Tools",
      "item": "https://thedevelopertools.com/json"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "JSON Compare",
      "item": "https://thedevelopertools.com/json/compare"
    }
  ]
};

const jsonLdFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does semantic JSON comparison work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The tool parses both documents, formats them consistently to eliminate whitespace discrepancies, and computes structural differences highlighting added, removed, and modified values."
      }
    },
    {
      "@type": "Question",
      "name": "Does the compare tool upload my files?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Both JSON documents are parsed and diffed locally in your browser memory without server communication."
      }
    }
  ]
};
---

<Layout
  title="JSON Diff & Compare — Compare Two JSON Files Online (Free & Private)"
  description="Compare two JSON documents side by side. Highlight additions, deletions, and modifications with semantic diffing. 100% browser-based and secure."
  canonicalUrl="https://thedevelopertools.com/json/compare"
  ogTitle="JSON Diff & Compare — Free Online Developer Tool"
  ogDescription="Side-by-side JSON difference checker. Compare two JSON payloads with color-coded additions, deletions, and edits."
  ogImageAlt="JSON Compare Tool"
  jsonLd={[jsonLdWebApp, jsonLdBreadcrumbs, jsonLdFAQ]}
>
  <main id="main-content" class="jt-page">
    <div class="jt-page-column">

      <!-- Breadcrumbs -->
      <nav class="pg-breadcrumbs" aria-label="Breadcrumb">
        <ol class="pg-breadcrumb-list">
          <li class="pg-breadcrumb-item"><a href="/" class="pg-breadcrumb-link">Home</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><a href="/json" class="pg-breadcrumb-link">JSON Tools</a></li>
          <li class="pg-breadcrumb-separator" aria-hidden="true">/</li>
          <li class="pg-breadcrumb-item"><span class="pg-breadcrumb-current" aria-current="page">JSON Compare</span></li>
        </ol>
      </nav>

      <!-- Page header -->
      <header class="jt-page-header">
        <div class="jt-page-header-inner">
          <span class="eyebrow jt-header-eyebrow">SEMANTIC JSON DIFF · SIDE-BY-SIDE INSPECTION</span>
          <h1 class="jt-page-title">JSON Diff &amp; Comparison Tool</h1>
          <p class="jt-page-sub">
            Compare two JSON payloads side by side with color-coded highlighting for added, removed, and modified values.
          </p>
        </div>
      </header>

      <!-- JSON Toolkit workspace initialized to Compare tab -->
      <JsonToolkit initialTab="compare" />

      <!-- Technical Documentation Article -->
      <article class="seo-article" aria-label="JSON Diff Documentation">
        <header class="seo-article-header">
          <span class="eyebrow">Technical Reference</span>
          <h2 class="seo-article-title">Semantic vs Text-Based JSON Comparison</h2>
        </header>

        <div class="seo-article-content">
          <p>
            Standard line-by-line diff tools (like generic git diffs) often produce noisy results when comparing JSON due to differences in indentation, trailing whitespace, or key ordering. A dedicated <strong>JSON diff tool</strong> parses both documents into structured objects, normalizes formatting, and computes the exact delta between properties and values.
          </p>

          <h3>Color-Coded Difference Markers</h3>
          <ul>
            <li><strong>Green (Added):</strong> Properties or array elements present in Document B that did not exist in Document A.</li>
            <li><strong>Red (Removed):</strong> Properties or array elements present in Document A that have been deleted in Document B.</li>
            <li><strong>Yellow / Orange (Modified):</strong> Keys whose values changed between versions (for example, a status flag changing from <code>false</code> to <code>true</code>).</li>
          </ul>

          <h3>Related JSON Utilities</h3>
          <ul>
            <li><a href="/json/formatter" class="seo-link">JSON Formatter</a>: Format either document individually.</li>
            <li><a href="/json/validator" class="seo-link">JSON Validator</a>: Check syntax validity before running diffs.</li>
            <li><a href="/json/viewer" class="seo-link">JSON Tree Viewer</a>: Inspect individual document trees.</li>
          </ul>
        </div>

        <p class="pg-csprng-note" role="contentinfo">
          100% Client-Side Engine · Zero Network Telemetry · Native Browser JavaScript
        </p>
      </article>

    </div>
  </main>
</Layout>

<style>
  .jt-page { padding: 24px 0 80px; width: 100%; }
  .jt-page-column {
    width: 100%; max-width: 1080px; margin-inline: auto; padding-inline: 20px;
    display: flex; flex-direction: column; align-items: stretch;
  }
  .pg-breadcrumbs { margin-bottom: 20px; }
  .pg-breadcrumb-list {
    display: flex; align-items: center; gap: 8px; list-style: none; margin: 0; padding: 0;
    font-size: 13px; color: var(--c-mute);
  }
  .pg-breadcrumb-link { color: var(--c-body); text-decoration: none; transition: color 120ms ease; }
  .pg-breadcrumb-link:hover { color: var(--c-ink); }
  .pg-breadcrumb-separator { color: var(--c-faint); }
  .pg-breadcrumb-current { color: var(--c-ink); font-weight: 500; }
  .jt-page-header { width: 100%; margin-bottom: 20px; text-align: center; }
  .jt-page-header-inner { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .jt-header-eyebrow { font-size: 11px; letter-spacing: 0.1em; }
  .jt-page-title {
    margin: 0; font-size: clamp(28px, 4vw, 36px); font-weight: 600; line-height: 1.15;
    letter-spacing: -0.03em; color: var(--c-ink);
  }
  .jt-page-sub { margin: 0; font-size: 14px; line-height: 22px; color: var(--c-body); text-align: center; max-width: 540px; }
  .seo-article { width: 100%; margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--c-hairline); }
  .seo-article-header { margin-bottom: 24px; }
  .seo-article-title { margin-top: 6px; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--c-ink); }
  .seo-article-content { display: flex; flex-direction: column; gap: 16px; font-size: 14px; line-height: 24px; color: var(--c-body); text-align: left; }
  .seo-article-content h2 { margin-top: 28px; margin-bottom: 10px; font-size: 18px; font-weight: 600; color: var(--c-ink); }
  .seo-article-content h3 { margin-top: 20px; margin-bottom: 6px; font-size: 15px; font-weight: 600; color: var(--c-ink); }
  .seo-article-content p { margin: 0; }
  .seo-article-content strong { color: var(--c-ink); font-weight: 600; }
  .seo-article-content code {
    font-family: var(--font-mono); font-size: 12px; background-color: var(--c-hairline-soft);
    padding: 1px 6px; border-radius: 4px; border: 1px solid var(--c-hairline); color: var(--c-ink);
  }
  .seo-article-content ul { margin: 0; padding-left: 20px; }
  .seo-article-content li { margin-bottom: 6px; }
  .seo-link { color: var(--c-link); text-decoration: underline; text-underline-offset: 2px; }
  .seo-link:hover { color: var(--c-ink); }
  .pg-csprng-note { margin: 28px 0 0; font-size: 11px; color: var(--c-mute); font-family: var(--font-mono); }
  @media (max-width: 640px) {
    .jt-page { padding: 16px 0 48px; }
    .jt-page-column { padding-inline: 14px; }
    .seo-article { margin-top: 36px; padding-top: 28px; }
  }
</style>
